# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# API Configuration
EXPO_PUBLIC_RORK_API_BASE_URL=https://your-app.vercel.app

# RevenueCat Configuration (for in-app purchases)
# Get these from https://app.revenuecat.com/ → Project Settings → API Keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_ios_api_key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=your_revenuecat_android_api_key

# Toolkit Configuration (for AI features)
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com

# YouTube API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Make sure YouTube Data API v3 is enabled
YOUTUBE_API_KEY=your_youtube_api_key_here
