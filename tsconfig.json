{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "projects",
    "scripts",
    "dist",
    "expo",
    "__old_iap.tsx"
  ],
  "compileOnSave": false
}
