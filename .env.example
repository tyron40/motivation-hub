# ============================================
# MOTIVATION HUB - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real keys to version control!

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Toolkit URL for AI features (image generation, STT, etc.)
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com

# Your deployed Vercel backend URL
# CRITICAL: This MUST be your actual Vercel deployment URL for production
# Example: https://your-app-name.vercel.app
# DO NOT use localhost or rorktest.dev URLs for production builds
EXPO_PUBLIC_RORK_API_BASE_URL=https://your-app-name.vercel.app

# ============================================
# YOUTUBE API (OPTIONAL - CLIENT SIDE)
# ============================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
# SECURITY WARNING: Client-side API keys are exposed in the app bundle
# For production, it's recommended to use backend-only YouTube fetching
# and remove this variable entirely
EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# ============================================
# SERVER-SIDE ONLY VARIABLES
# ============================================
# These should ONLY be set in Vercel environment variables
# DO NOT set actual values here - they will be exposed!
# Set these in: https://vercel.com/your-project/settings/environment-variables

# YouTube API Key (Server-side for backend YouTube fetching)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenAI API Key (Server-side for TTS and Chat features)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to TestFlight/App Store:
# 
# 1. Set EXPO_PUBLIC_RORK_API_BASE_URL to your Vercel URL
# 2. Remove EXPO_PUBLIC_YOUTUBE_API_KEY (use backend instead)
# 3. Set YOUTUBE_API_KEY in Vercel environment variables
# 4. Set OPENAI_API_KEY in Vercel environment variables
# 5. Verify EXPO_PUBLIC_SUPABASE_URL and EXPO_PUBLIC_SUPABASE_ANON_KEY
# 6. Test all features on physical device before submitting
# 7. Increment version and buildNumber in app.json
# 8. Run: eas build --platform ios --profile production
