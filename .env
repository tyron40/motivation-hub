# Backend API URL (Required for tRPC and backend features)
# IMPORTANT: This MUST be your deployed Vercel backend URL for TestFlight/Production
# The app will use this URL to fetch YouTube videos, TTS, and chat features
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com
EXPO_PUBLIC_RORK_API_BASE_URL=https://motivation-hub-iota.vercel.app

# YouTube Data API v3 Key (SERVER-SIDE ONLY - for backend/Vercel)
# This is used in the backend tRPC routes to fetch YouTube videos
# IMPORTANT: This should ONLY be set in Vercel environment variables, NOT in this file
# The app will use the backend API to fetch YouTube videos (no client-side API key needed)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# OpenAI API Key (SERVER-SIDE ONLY - DO NOT USE EXPO_PUBLIC_ PREFIX)
# This key is only accessible from the backend and will not be exposed to clients
# IMPORTANT: This should ONLY be set in Vercel environment variables, NOT in this file
# Remove the actual key from this file for security
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
