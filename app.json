{
"expo": {
  "name": "Motivation Hub",
  "slug": "motivational-app",
  "version": "1.1.1",
  "orientation": "portrait",
  "icon": "./assets/images/icon.png",
  "scheme": "myapp",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": false,
  "splash": {
    "image": "./assets/images/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#ffffff"
  },
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "app.rork.motivational-speech-app",
    "buildNumber": "65",
    "infoPlist": {
      "UIBackgroundModes": ["audio"],
      "NSMicrophoneUsageDescription": "Motivation Hub uses your microphone only when you press and hold to speak with the Voice Coach feature.",
      "NSPhotoLibraryUsageDescription": "Motivation Hub lets you personalize your profile by selecting a photo from your library.",
      "NSCameraUsageDescription": "Motivation Hub allows you to take a new photo for your profile picture.",
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": false,
        "NSExceptionDomains": {
          "googleapis.com": {
            "NSIncludesSubdomains": true,
            "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
          },
          "vercel.app": {
            "NSIncludesSubdomains": true,
            "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
          },
          "youtube.com": {
            "NSIncludesSubdomains": true,
            "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
          },
          "supabase.co": {
            "NSIncludesSubdomains": true,
            "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
          }
        }
      }
    }
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "package": "app.rork.motivational-speech-app",
    "versionCode": 65,
    "permissions": ["RECORD_AUDIO", "INTERNET", "CAMERA", "READ_EXTERNAL_STORAGE"]
  },
  "web": {
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    ["expo-router", { "origin": "https://rork.com/" }],
    ["expo-av", { "microphonePermission": "Motivation Hub uses your microphone only when you press and hold to speak with the Voice Coach feature." }],
    ["expo-image-picker", {
      "photosPermission": "Motivation Hub lets you personalize your profile by selecting a photo from your library.",
      "cameraPermission": "Motivation Hub allows you to take a new photo for your profile picture."
    }]
  ],
  "extra": {
    "eas": {
      "projectId": "7389ef4c-4537-4e7b-9081-c30a7e9c22bd"
    }
  }
}
}