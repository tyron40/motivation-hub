{
  "expo": {
    "name": "Motivation Hub",
    "slug": "motivational-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.motivational-speech-app",
      "buildNumber": "56",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "We use your microphone only when you hold to speak with the Voice Coach. For example, press and hold to ask a question, and we transcribe your voice to text.",
        "NSPhotoLibraryUsageDescription": "We access your photo library when you choose to set a profile picture. For example, tap the camera icon on your profile to select a photo from your library to personalize your account.",
        "NSCameraUsageDescription": "We use your camera when you choose to take a profile picture. For example, tap the camera icon on your profile to take a new photo to personalize your account.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "googleapis.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionRequiresForwardSecrecy": true,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "vercel.app": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionRequiresForwardSecrecy": true,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "youtube.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionRequiresForwardSecrecy": true,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            },
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false,
              "NSTemporaryExceptionRequiresForwardSecrecy": true,
              "NSTemporaryExceptionMinimumTLSVersion": "TLSv1.2"
            }
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.motivational-speech-app",
      "versionCode": 56,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "usesCleartextTraffic": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "We use your microphone only when you hold to speak with the Voice Coach. For example, press and hold to ask a question, and we transcribe your voice to text."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "We access your photo library when you choose to set a profile picture. For example, tap the camera icon on your profile to select a photo from your library to personalize your account.",
          "cameraPermission": "We use your camera when you choose to take a profile picture. For example, tap the camera icon on your profile to take a new photo to personalize your account."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7389ef4c-4537-4e7b-9081-c30a7e9c22bd"
      }
    }
  }
}