{
  "expo": {
    "name": "Motivation Fuel",
    "slug": "motivational-app",
    "version": "1.1.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.motivational-speech-app",
      "buildNumber": "120",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Motivation Hub uses your microphone only when you press and hold to speak with the Voice Coach feature.",
        "NSPhotoLibraryUsageDescription": "Motivation Hub lets you personalize your profile by selecting a photo from your library.",
        "NSCameraUsageDescription": "Motivation Hub allows you to take a new photo for your profile picture.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "googleapis.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            },
            "vercel.app": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            },
            "youtube.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            },
            "supabase.co": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.motivational-speech-app",
      "versionCode": 120,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Motivation Hub uses your microphone only when you press and hold to speak with the Voice Coach feature."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Motivation Hub lets you personalize your profile by selecting a photo from your library.",
          "cameraPermission": "Motivation Hub allows you to take a new photo for your profile picture."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7788769813708919~4966903177",
          "iosAppId": "ca-app-pub-7788769813708919~4966903177"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7389ef4c-4537-4e7b-9081-c30a7e9c22bd"
      }
    }
  }
}